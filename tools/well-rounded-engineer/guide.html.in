<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Atkinson+Hyperlegible:wght@400;700&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
/* Layout: sticky header with tabs + filter, then a two-column grid of reference cards per tab */
:root{
  --bg:#f3f5f7; --surface:#ffffff; --fg:#17202b; --muted:#566273; --line:#d9dfe6;
  --accent:#1f5fbf; --accent-soft:#e3ecfa; --code-bg:#f0f3f7; --code-fg:#1b2533;
  --lts:#13795b; --lts-soft:#dcf2e9; --prev:#9a5b00; --prev-soft:#fbeed7;
  --f-display:"Schibsted Grotesk", "Segoe UI", system-ui, sans-serif;
  --f-body:"Atkinson Hyperlegible", "Segoe UI", system-ui, sans-serif;
  --f-mono:"JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#0f141b; --surface:#161d26; --fg:#e4e9ef; --muted:#9aa7b6; --line:#2a3542;
  --accent:#7fb0ff; --accent-soft:#1c2c45; --code-bg:#0b1016; --code-fg:#d6e0ec;
  --lts:#5fd3a6; --lts-soft:#123327; --prev:#f2b866; --prev-soft:#3a2a10; color-scheme:dark }}
:root[data-theme="dark"]{
  --bg:#0f141b; --surface:#161d26; --fg:#e4e9ef; --muted:#9aa7b6; --line:#2a3542;
  --accent:#7fb0ff; --accent-soft:#1c2c45; --code-bg:#0b1016; --code-fg:#d6e0ec;
  --lts:#5fd3a6; --lts-soft:#123327; --prev:#f2b866; --prev-soft:#3a2a10; color-scheme:dark }

*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font:15px/1.55 var(--f-body)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
.wrap{max-width:1240px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-bottom:1px solid var(--line)}
header .wrap{display:flex;flex-wrap:wrap;align-items:center;gap:10px 20px;padding-block:12px}
h1{font:800 20px/1.1 var(--f-display);margin:0;letter-spacing:-.01em}
h1 small{display:block;font:500 12px/1.3 var(--f-body);color:var(--muted);letter-spacing:.02em}
.smile{width:1.25em;height:1.25em;vertical-align:-.3em;margin-right:5px;color:var(--accent)}
nav{display:flex;gap:4px;flex-wrap:wrap}
nav a{font:700 14px var(--f-display);color:var(--muted);text-decoration:none;padding:6px 12px;border-radius:6px}
nav a:hover{color:var(--fg);background:var(--code-bg)}
.navgrp{font:700 10.5px var(--f-body);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:6px 2px 6px 10px;white-space:nowrap}
nav a{white-space:nowrap}
nav a[aria-current="page"]{color:var(--accent);background:var(--accent-soft)}
nav a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.search{margin-left:auto;flex:1 1 220px;max-width:320px}
.search input{width:100%;font:15px var(--f-body);color:var(--fg);background:var(--code-bg);border:1px solid var(--line);border-radius:6px;padding:7px 10px}
main{padding-block:20px 48px}
.panel-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;margin:0 0 14px}
.panel-head h2{font:800 26px/1.15 var(--f-display);margin:0;text-wrap:balance}
.panel-head p{margin:0;color:var(--muted);max-width:70ch}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,520px),1fr));gap:14px;align-items:start}
.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:14px 16px;min-width:0}
.card h3{font:700 16px/1.3 var(--f-display);margin:0 0 8px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;text-wrap:balance}
.card p,.card li{margin:6px 0;max-width:72ch}
.card ul{padding-left:18px;margin:6px 0}
.card.wide{grid-column:1/-1}
code{font:13px/1.5 var(--f-mono);background:var(--code-bg);color:var(--code-fg);padding:1px 4px;border-radius:4px}
.snip{position:relative;margin:8px 0}
pre{margin:0;background:var(--code-bg);color:var(--code-fg);border:1px solid var(--line);border-radius:6px;padding:10px 12px;overflow-x:auto;font:12.8px/1.55 var(--f-mono);tab-size:2}
pre code{background:none;padding:0;font:inherit;overflow-wrap:normal;word-break:normal}
p code,li code,td code{overflow-wrap:anywhere}
.copy{position:absolute;top:6px;right:6px;font:600 11px var(--f-body);color:var(--muted);background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:2px 8px;cursor:pointer;opacity:.85}
.copy:hover{color:var(--accent);opacity:1}
.tag{font:700 10.5px/1 var(--f-body);letter-spacing:.06em;text-transform:uppercase;padding:4px 6px;border-radius:4px;background:var(--accent-soft);color:var(--accent)}
.tag.lts{background:var(--lts-soft);color:var(--lts)}
.tag.prev{background:var(--prev-soft);color:var(--prev)}
.tbl{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}
th{font:700 12px var(--f-body);letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
td:first-child{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:700}
.note{font-size:13.5px;color:var(--muted)}
.empty{color:var(--muted);padding:24px 0}
.group-label{font:700 12px var(--f-body);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:22px 0 8px}
.levels{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:10px;margin:6px 0}
.lvl{border:1px solid var(--line);border-radius:6px;padding:8px 10px;background:var(--bg);min-width:0}
.lvl h4,.explore h4{margin:0 0 4px;font:700 14px var(--f-display)}
.lvl ul{margin:0;padding-left:16px}.lvl p{margin:0}
.lvtag{display:inline-block;min-width:20px;text-align:center;border-radius:4px;background:var(--accent-soft);color:var(--accent);font:700 12px var(--f-body);padding:1px 5px;margin-right:4px}
.explore{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:14px}
.explore ul{padding-left:18px;margin:4px 0}
.links li{margin:5px 0}.links a{color:var(--accent);font-weight:700}
.lnote{color:var(--muted);font-size:13.5px}
.gmap{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:12px;margin-top:8px}
.gmap-card{border:1px solid var(--line);border-radius:6px;padding:10px 12px;background:var(--bg);min-width:0}
.gmap-card h4{margin:0 0 4px}.gmap-card p{margin:4px 0}
.gmap-n{display:inline-block;min-width:22px;text-align:center;border-radius:4px;background:var(--accent-soft);color:var(--accent);font:700 12px var(--f-body);padding:1px 5px;margin-right:4px}
.gmap-pages{font-size:14px;color:var(--muted)}
.gmap-run a,.runcode a{font-weight:700;overflow-wrap:anywhere}
.quote{margin:4px 0 10px;padding:8px 14px;border-left:3px solid var(--accent);font-style:italic}
.quote-by{display:block;margin-top:6px;font-style:normal;font-size:14px;color:var(--muted)}
.sources{margin:12px 0 0;font-size:14px;color:var(--muted);overflow-wrap:anywhere}
.runcode{margin:12px 0 0;padding-top:10px;border-top:1px solid var(--line)}
details{border:1px solid var(--line);border-radius:6px;margin:8px 0;background:var(--surface)}
details>summary{cursor:pointer;padding:8px 10px;font-weight:700;list-style-position:inside}
details>summary:hover{color:var(--accent)}
details[open]>summary{border-bottom:1px solid var(--line)}
details>.inner{padding:4px 10px 8px}
.ex{font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums}
@media (max-width:900px){ header nav{flex-wrap:nowrap;overflow-x:auto;width:100%;order:3;scrollbar-width:thin} }
@media (max-width:640px){ .search{max-width:none;margin-left:0} h1{font-size:18px} }
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
/* Diagrams: inline SVG figures drawn with the theme's colour tokens */
.fig{margin:10px 0 6px;overflow-x:auto}
.fig svg{display:block;width:100%;height:auto;max-width:620px;min-width:460px}
.fig figcaption{color:var(--muted);font-size:13px;margin-top:6px;max-width:72ch}
.fig .nd{fill:var(--surface);stroke:var(--fg);stroke-width:1.5}
.fig .nd.in{fill:var(--accent-soft)}
.fig .nd.out{fill:var(--lts-soft)}
.fig .ed{stroke:var(--muted);stroke-width:1;fill:none}
.fig .ar{fill:var(--muted)}
.fig .lb{fill:var(--fg);font:14px var(--f-body)}
.fig .lb.hd{font-weight:700;font-family:var(--f-display)}
.fig .lb.mu{fill:var(--muted);font-size:13px}
.fig .lb.big{font-size:22px}
.fig .bd{fill:none;stroke:var(--accent);stroke-width:1.5;stroke-dasharray:6 4}
.fig .ed.dash{stroke-dasharray:5 4}
.fig .ed.acc{stroke:var(--accent)}
.fig .ar.acc{fill:var(--accent)}
.fig .lb.acc{fill:var(--accent)}
.fig .nd.warn{fill:var(--prev-soft);stroke-dasharray:4 3}
.fig .dot{fill:var(--fg)}
.fig .ln{stroke:var(--line);stroke-width:1.5;stroke-dasharray:4 4}
</style>

